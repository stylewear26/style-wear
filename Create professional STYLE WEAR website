<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>STYLE WEAR - Online Clothing Store</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family:Arial, sans-serif;
    background:#f6f6f6;
    color:#222;
}

.topbar{
    background:#111;
    color:#fff;
    text-align:center;
    padding:10px;
    font-size:14px;
}

header{
    background:#fff;
    padding:18px 6%;
    display:flex;
    justify-content:space-between;
    align-items:center;
    position:sticky;
    top:0;
    z-index:100;
    box-shadow:0 2px 10px #ddd;
}

.logo{
    font-size:26px;
    font-weight:bold;
    letter-spacing:2px;
}

nav a{
    color:#222;
    text-decoration:none;
    margin:0 12px;
    font-weight:bold;
}

.cart{
    background:#111;
    color:#fff;
    padding:10px 16px;
    border-radius:25px;
}

.hero{
    min-height:500px;
    background:linear-gradient(120deg,#111,#444);
    color:#fff;
    display:flex;
    align-items:center;
    padding:60px 8%;
}

.hero-content{
    max-width:600px;
}

.hero h1{
    font-size:55px;
    margin-bottom:20px;
}

.hero p{
    font-size:20px;
    margin-bottom:30px;
    line-height:1.6;
}

.btn{
    display:inline-block;
    background:#fff;
    color:#111;
    padding:14px 28px;
    border-radius:30px;
    text-decoration:none;
    font-weight:bold;
}

section{
    padding:60px 7%;
}

.title{
    text-align:center;
    margin-bottom:35px;
}

.title h2{
    font-size:32px;
    margin-bottom:10px;
}

.categories{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:20px;
}

.category{
    background:#fff;
    padding:45px 20px;
    text-align:center;
    border-radius:15px;
    box-shadow:0 4px 15px #ddd;
}

.category h3{
    font-size:22px;
    margin-bottom:10px;
}

.products{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:22px;
}

.product{
    background:#fff;
    border-radius:15px;
    overflow:hidden;
    box-shadow:0 4px 15px #ddd;
}

.product img{
    width:100%;
    height:270px;
    object-fit:cover;
    background:#eee;
}

.product-info{
    padding:18px;
}

.product-info h3{
    margin-bottom:10px;
}

.price{
    font-size:20px;
    font-weight:bold;
}

.old{
    text-decoration:line-through;
    color:#888;
    margin-left:8px;
}

.buy{
    display:block;
    text-align:center;
    margin-top:15px;
    background:#111;
    color:#fff;
    padding:12px;
    border-radius:8px;
    text-decoration:none;
}

.offer{
    background:#111;
    color:#fff;
    text-align:center;
    border-radius:20px;
    padding:50px 20px;
}

.offer h2{
    font-size:35px;
    margin-bottom:15px;
}

.features{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:20px;
}

.feature{
    background:#fff;
    padding:30px 15px;
    text-align:center;
    border-radius:15px;
    box-shadow:0 3px 12px #ddd;
}

.feature h3{
    margin-bottom:10px;
}

.newsletter{
    background:#eee;
    text-align:center;
}

.newsletter input{
    width:300px;
    max-width:90%;
    padding:14px;
    border:1px solid #ccc;
    border-radius:25px;
    margin:15px 5px;
}

.newsletter button{
    padding:14px 25px;
    border:0;
    border-radius:25px;
    background:#111;
    color:#fff;
    font-weight:bold;
}

footer{
    background:#111;
    color:#fff;
    padding:45px 7%;
    text-align:center;
}

footer p{
    margin:10px 0;
    color:#ccc;
}

@media(max-width:800px){
    nav{
        display:none;
    }

    .hero{
        min-height:430px;
        text-align:center;
        justify-content:center;
    }

    .hero h1{
        font-size:40px;
    }

    .categories,
    .products,
    .features{
        grid-template-columns:repeat(2,1fr);
    }
}

@media(max-width:500px){
    .categories,
    .products,
    .features{
        grid-template-columns:1fr;
    }

    header{
        padding:15px 4%;
    }

    .hero{
        padding:50px 5%;
    }

    .hero h1{
        font-size:34px;
    }
}
</style>
</head>

